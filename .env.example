# Copy to .env and adjust. Paths must be absolute.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# 8192 tokens uses about 2.6 GB. Raising it increases memory use.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT_SECONDS=120
# How long a model stays in memory after a call.
OLLAMA_KEEP_ALIVE=2m

# Comma-separated project roots the agents may read. Empty means no access.
ALLOWED_WORKSPACES=/absolute/path/to/your/project

# Comma-separated project roots whose tests may be run. Running tests executes that
# project's code on this machine, outside any sandbox. Empty means never.
ALLOWED_TEST_WORKSPACES=
TEST_TIMEOUT_SECONDS=120

MAX_FILE_BYTES=200000
MAX_REVIEW_FILES=10

LOG_LEVEL=INFO
